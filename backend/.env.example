PORT=3001
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: enables a live per-address AVM value estimate blended into the
# free calculation, via services/listingsApiService.js. Does NOT supply
# photos (confirmed unavailable on this endpoint) — see that file's header
# comment. Leave unset to run entirely on the free public-data engine.
# RENTCAST_API_KEY=

# Optional: enables real comparable-listing photos on the results screen,
# via services/simplyRetsService.js. HTTP Basic Auth (username + password),
# not an API key. For testing, SimplyRETS's public demo account works with
# no signup: username "simplyrets", password "simplyrets" (returns fake
# sample listings, useful for verifying the integration end-to-end). A real
# account with live MLS data requires being sponsored by a licensed agent
# or broker with IDX access — see that file's header comment for the
# attribution expectations that come with real MLS data.
# SIMPLYRETS_USERNAME=
# SIMPLYRETS_PASSWORD=
