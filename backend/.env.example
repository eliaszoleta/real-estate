PORT=3001
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: enables real comparable-listing photos on the results screen,
# via services/simplyRetsService.js. HTTP Basic Auth (username + password),
# not an API key. For testing, SimplyRETS's public demo account works with
# no signup: username "simplyrets", password "simplyrets" (returns fake
# sample listings fixed to Katy, TX / ZIP 77430 — useful for verifying the
# integration end-to-end, not for real coverage anywhere else). A real
# account with live MLS data requires being sponsored by a licensed agent
# or broker with IDX access — see that file's header comment for the
# attribution expectations that come with real MLS data.
# SIMPLYRETS_USERNAME=
# SIMPLYRETS_PASSWORD=

# Optional: enables a well-matched, properly-licensed STOCK photo fallback
# whenever no real comp photo is found (which is most searches — SimplyRETS
# coverage is inherently narrow). Free, self-serve key at pexels.com/api,
# no application review. See services/pexelsService.js for details.
# PEXELS_API_KEY=

# NOT used — kept only because services/listingsApiService.js still exists
# as a working-but-unused integration. Its AVM value was never wired into
# anything the frontend displays, so calling it was pure wasted quota; see
# that file's header comment if you want to revive it.
# RENTCAST_API_KEY=
